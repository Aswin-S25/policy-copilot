# Copy to .env.local to override. Never put tokens or secrets here:
# every VITE_ variable is compiled into the public JavaScript bundle.

# Base URL the browser uses for API calls. The default "/api" goes through
# the Vite dev proxy below; in production, serve the built app and the API
# behind one origin and point this at the API path.
VITE_API_BASE_URL=/api

# Dev server only (not exposed to the browser): where /api is forwarded.
API_PROXY_TARGET=http://127.0.0.1:8000
