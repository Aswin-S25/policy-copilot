# Copy to .env and fill in. Never commit .env.

# Required by every process.
POLICY_DATABASE_URL=postgresql+psycopg://policy_user:policy_password@localhost:5433/policy_copilot

# Required by the API only. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
POLICY_JWT_SECRET=

# Optional (defaults shown).
POLICY_OLLAMA_HOST=http://127.0.0.1:11434
POLICY_LLM_MODEL=qwen3:8b
POLICY_JUDGE_MODEL=qwen3:8b
POLICY_LLM_TIMEOUT_S=120
POLICY_LLM_HELPER_TIMEOUT_S=30
POLICY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
POLICY_CELERY_BROKER_URL=redis://localhost:6379/0
POLICY_CELERY_RESULT_BACKEND=redis://localhost:6379/1
POLICY_DB_CONNECT_TIMEOUT_S=5
POLICY_LLM_KEEP_ALIVE=30m
POLICY_WARMUP_ON_STARTUP=true
POLICY_READINESS_CACHE_S=5

# Tests only (must end in _test).
# POLICY_TEST_DATABASE_URL=postgresql+psycopg://policy_user:policy_password@localhost:5433/policy_copilot_test
